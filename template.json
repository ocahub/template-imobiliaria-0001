{
  "id": "template-imobiliaria-0001",
  "name": "Imobiliária 0001",
  "version": "1.0.0",
  "description": "Site de imobiliária com busca no topo, vitrines de imóveis, categorias, corretor e contato pelo WhatsApp.",
  "modules": [
    "imob"
  ],
  "groups": [
    "Topo",
    "Imóveis",
    "Conteúdo",
    "Contato"
  ],
