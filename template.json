      {
        "id": "oceano",
        "label": "Oceano",
        "primary": "#0f2c40",
        "accent": "#1b8389",
        "soft": "#eef5f5",
        "ink": "#13222c"
      },
      {
        "id": "areia",
        "label": "Areia",
        "primary": "#2d2722",
        "accent": "#a8732f",
        "soft": "#f6f0e6",
        "ink": "#241f1a"
      },
      {
        "id": "laranja",
        "label": "Laranja",
        "primary": "#1d1d1f",
        "accent": "#e25a00",
        "soft": "#f6f2ee",
        "ink": "#1d1d1f"
      },
      {
        "id": "mata",
        "label": "Mata",
        "primary": "#1d3a31",
        "accent": "#3b8259",
        "soft": "#edf4ef",
        "ink": "#17251f"
      }
    ],
    "fonts": [
      {
        "id": "classica",
        "label": "Clássica",
        "display": "'DM Serif Display', Georgia, serif",
        "body": "'Manrope', system-ui, sans-serif",
        "weight": 400
      },
      {
        "id": "moderna",
        "label": "Moderna",
        "display": "'Manrope', system-ui, sans-serif",
        "body": "'Manrope', system-ui, sans-serif",
        "weight": 800
      }
    ]
  },
  "sections": [
    {
      "type": "header",
      "label": "Cabeçalho",
      "group": "Global",
      "global": true,
      "description": "Logo, menu e botão do WhatsApp. Aparece em todas as páginas.",
      "fields": [
        {
          "key": "logoImage",
          "label": "Logo (imagem)",
          "type": "image",
          "optional": true,
          "help": "Sem imagem, vale o logotipo da loja; sem ele, o nome em texto."
        },
        {
          "key": "logo",
          "label": "Nome da marca",
          "type": "text"
        },
        {
          "key": "phone",
          "label": "Telefone",
          "type": "text"
        },
        {
          "key": "cta",
          "label": "Texto do botão",
          "type": "text",
          "help": "O botão abre o WhatsApp da loja (Loja › Dados da loja › Contatos do site)."
        }
      ]
    },
    {
      "type": "hero",
      "label": "Destaque com busca",
      "group": "Topo",
      "description": "Foto grande, título e a busca de imóveis com filtros rápidos.",
      "fields": [
        {
          "key": "image",
          "label": "Imagem de fundo",
          "type": "image"
        },
        {
          "key": "eyebrow",
          "label": "Chamada pequena",
          "type": "text"
        },
        {
          "key": "title",
          "label": "Título",
          "type": "text"
        },
        {
          "key": "subtitle",
          "label": "Subtítulo",
          "type": "area"
        },
        {
          "key": "ops",
          "label": "Abas da busca",
          "type": "checks",
          "options": [
            {
              "value": "VENDA",
              "label": "Comprar"
            },
            {
              "value": "LOCACAO",
              "label": "Alugar"
            },
            {
              "value": "TEMPORADA",
              "label": "Temporada"
            }
          ]
        },
        {
          "key": "chips",
          "label": "Mais buscados",
          "type": "items",
          "max": 6,
          "itemTitle": "label",
          "help": "Cada um busca os imóveis com essa característica, escrita igual ao cadastro.",
          "fields": [
            {
              "key": "label",
              "label": "Característica",
              "type": "text"
            }
          ],
          "newItem": {
            "label": "Nova característica"
          }
        },
        {
          "key": "stat",
          "label": "Frase abaixo da busca",
          "type": "text"
        }
      ]
    },
    {
      "type": "banner",
      "label": "Banner com chamada",
