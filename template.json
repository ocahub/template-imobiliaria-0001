          "key": "subtitle",
          "label": "Subtítulo",
          "type": "area"
        },
        {
          "key": "source",
          "label": "Quais imóveis mostrar",
          "type": "select",
          "options": [
            {
              "value": "destaques",
              "label": "Marcados como destaque"
            },
            {
              "value": "venda",
              "label": "À venda"
            },
            {
              "value": "aluguel",
              "label": "Para alugar"
            },
            {
              "value": "temporada",
              "label": "Temporada"
            },
            {
              "value": "caracteristica",
              "label": "Com uma característica"
